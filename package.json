{
  "name": "@nachx639/termide",
  "version": "0.2.0",
  "description": "A terminal-first IDE with embedded shell for AI coding agents",
  "keywords": [
    "tui",
    "terminal",
    "ide",
    "editor",
    "bun",
    "opentui",
    "ai-agents",
    "acp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nachx639/termide.git"
  },
  "homepage": "https://github.com/Nachx639/termide#readme",
  "bugs": {
    "url": "https://github.com/Nachx639/termide/issues"
  },
  "type": "module",
  "bin": {
    "termide": "./src/index.tsx"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/fixtures",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ACP.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit -p .",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "ws": "8.22.0"
  }
}
