{
  "name": "termide",
  "version": "0.2.0",
  "description": "A terminal-first IDE with embedded shell for AI coding agents",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "termide": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit -p .",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "react": "19.3.0",
    "ws": "8.21.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "ws": "8.21.0"
  }
}
